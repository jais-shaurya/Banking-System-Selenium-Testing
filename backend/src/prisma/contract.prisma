// use prisma-8

enum TransactionStatus {
  @@type("pg/text@1")
  pending   = "pending"
  completed = "completed"
  failed    = "failed"
}

enum TransactionType {
  @@type("pg/text@1")
  transfer   = "TRANSFER"
  deposit    = "DEPOSIT"
  withdrawal = "WITHDRAWAL"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  phNumber     String    @unique @map("ph_number")
  password     String
  accounts     Account[]

  @@check(expression: sql`ph_number ~ '^[0-9]{10}$'`, name: "user_phone_number_format")
  @@map("User")
}

model Account {
  id             Int                  @id @default(autoincrement())
  userId         Int                  @map("user_id")
  accountNumber  Numeric(11)         @unique @map("account_number")
  balance        Numeric(19, 2)       @default(0.00)
  user           User                 @relation(fields: [userId], references: [id])
  payerTransfers Transaction[]        @relation("PayerAccount")
  payeeTransfers Transaction[]        @relation("PayeeAccount")
  deleted        Boolean              @default(false)

  @@check(expression: sql`account_number > 0`, name: "positive_account_number")
  @@check(expression: sql`balance >= 0`, name: "account_balance_nonnegative")
  @@map("Account")
}

model Transaction {
  id             Int               @id @default(autoincrement())
  payeeAccountId Int?               @map("payee_account_id")
  payerAccountId Int?               @map("payer_account_id")
  amount         Numeric(19, 2)
  type          TransactionType
  status         TransactionStatus
  createdAt      TimestamptzString  @default(now()) @map("created_at")
  payeeAccount   Account?           @relation("PayeeAccount", fields: [payeeAccountId], references: [id])
  payerAccount   Account?           @relation("PayerAccount", fields: [payerAccountId], references: [id])

  @@check(expression: sql`amount > 0`, name: "transaction_amount_positive")
  @@check(expression: sql`type <> 'TRANSFER' OR payer_account_id <> payee_account_id`, name: "transaction_distinct_accounts")

  @@check(
  expression: sql`(
      ("type" = 'TRANSFER' AND payer_account_id IS NOT NULL AND payee_account_id IS NOT NULL)
      OR
      ("type" = 'DEPOSIT' AND payer_account_id IS NULL AND payee_account_id IS NOT NULL)
      OR
      ("type" = 'WITHDRAWAL' AND payer_account_id IS NOT NULL AND payee_account_id IS NULL)
    )`,
    name: "transaction_accounts_by_type"
  )
  
  @@index([payerAccountId, createdAt])
  @@index([payeeAccountId, createdAt])

  @@map("Transaction")
}